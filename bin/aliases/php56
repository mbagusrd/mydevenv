#!/usr/bin/env bash
COMPOSE_FILE="D:/Users/Bagus/Documents/dev/mydevenv/docker-compose.yml"
SERVICE="php56"
HOST_DIR="D:/Users/Bagus/Documents/dev/projects-web"
WORKDIR="/srv"

CURR="$(pwd -P)"
WIN_CURR="$(pwd -W 2>/dev/null || cygpath -w "$CURR" 2>/dev/null || echo "$CURR")"
WIN_CURR="${WIN_CURR//\\//}"
if [[ "$CURR" == "$HOST_DIR"* ]]; then
    REL="${CURR#$HOST_DIR}"
    WORKDIR="/srv${REL}"
elif [[ "$WIN_CURR" == "$HOST_DIR"* ]]; then
    REL="${WIN_CURR#$HOST_DIR}"
    WORKDIR="/srv${REL}"
fi

docker compose -f "$COMPOSE_FILE" exec -w "$WORKDIR" "$SERVICE" php "$@"
