#!/usr/bin/env bash
COMPOSE_FILE="D:/Users/Bagus/Documents/hermes-work/prototypes/mydevenv/docker-compose.yml"
SERVICE="php74"
HOST_DIR="D:/Users/Bagus/Documents/dev/projects-web"
WORKDIR="/srv"

CURR="$(pwd -P)"
if [[ "$CURR" == "$HOST_DIR"* ]]; then
